<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Fontes: Segoe UI Variable (Windows 11) com Segoe UI como reserva. Ícones: Lucide (traço fino e arredondado, embutida em
       Assets/Fonts, licença ISC); um código que a Lucide não tem cai, caractere por caractere, na Segoe Fluent / MDL2 -->
  <FontFamily x:Key="IconFont">pack://application:,,,/Qrztweaks;component/Assets/Fonts/#lucide, Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <!-- Escala tipográfica (DIP): legenda 11 · secundário 12 · corpo 13 · título de card 16 · valores 26 · título da página 28 -->
  <sys:Double x:Key="FontSizeCaption">11</sys:Double>
  <sys:Double x:Key="FontSizeSecondary">12</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeCardTitle">16</sys:Double>
  <sys:Double x:Key="FontSizeSection">18</sys:Double>
  <sys:Double x:Key="FontSizeValue">26</sys:Double>
  <sys:Double x:Key="FontSizePageTitle">28</sys:Double>

  <!-- Raios em degraus (Fluent). O ThemeService publica os mesmos valores em runtime; estes servem ao designer e aos
       testes que montam a interface sem o tema aplicado. -->
  <CornerRadius x:Key="CardRadius">20</CornerRadius>
  <CornerRadius x:Key="InsetRadius">12</CornerRadius>
  <CornerRadius x:Key="ControlRadius">10</CornerRadius>
  <CornerRadius x:Key="BadgeRadius">8</CornerRadius>
</ResourceDictionary>
