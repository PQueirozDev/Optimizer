<Window x:Class="PQueirozOptimizer.ActivationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ativar Qrztweaks" Width="560" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Grid>
    <Border Background="{DynamicResource GlowBrush}" IsHitTestVisible="False"/>
    <StackPanel Margin="44,38,44,32">
      <StackPanel Orientation="Horizontal">
        <Border Width="44" Height="44">
          <Image Source="pack://application:,,,/Qrztweaks;component/Assets/app.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Qrztweaks" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
          <TextBlock Text="PC OPTIMIZER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
      </StackPanel>

      <TextBlock x:Name="HeadingText" Text="Ative sua licença" FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,28,0,6"/>
      <TextBlock Text="Cole abaixo a chave de acesso recebida. Ela fica vinculada a este computador." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,24"/>

      <!-- Por que a licença salva não abriu o app (expirada ou inválida) -->
      <Border x:Name="ProblemBanner" Visibility="Collapsed" CornerRadius="12" Padding="14,12" Margin="0,-6,0,22" Background="{DynamicResource WarningSoftBrush}">
        <DockPanel>
          <TextBlock x:Name="ProblemIcon" Text="&#xE7BA;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,12,0"/>
          <StackPanel>
            <TextBlock x:Name="ProblemTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProblemText" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="Chave de acesso" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox x:Name="AccessKeyTextBox" Height="44" Padding="12,0" VerticalContentAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"/>

      <TextBlock Text="ID deste computador" FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,8"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Copiar pedido" Width="120" Height="40" Margin="10,0,0,0" Padding="0" Click="CopyMachineId_Click"/>
        <TextBox x:Name="MachineIdTextBox" IsReadOnly="True" Height="40" Padding="12,0" VerticalContentAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Background="{DynamicResource CardBgBrush}"/>
      </DockPanel>
      <TextBlock Text="Copie o pedido e envie para receber sua chave. Ao copiar a chave recebida, ela é colada aqui automaticamente." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,6,0,0"/>

      <!-- Planos e preços (os mesmos do site); a compra e a ativação são feitas pelo suporte -->
      <Border CornerRadius="12" Padding="14,12" Margin="0,18,0,0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Planos" FontSize="12.5" FontWeight="SemiBold"/>
          <TextBlock x:Name="PlansText" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
          <WrapPanel>
            <Button Content="Ver planos no site" Height="34" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource GhostButton}" Click="Plans_Click"/>
            <Button x:Name="TransferButton" Content="Troquei de PC / reinstalei o Windows" Height="34" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource GhostButton}" Click="Transfer_Click"
                    ToolTip="Copia um pedido de transferência com o novo ID deste computador"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" MinHeight="22" FontSize="12.5" Margin="0,16,0,0"/>
      <DockPanel Margin="0,14,0,0">
        <Button Content="Sair" Width="96" Height="42" Padding="0" Margin="0" Style="{StaticResource GhostButton}" Click="Exit_Click"/>
        <Button x:Name="DemoButton" Content="Explorar sem licença" Height="42" Padding="14,0" Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="Demo_Click"
                ToolTip="Modo demonstração: veja o hardware, o monitor, o diagnóstico e as recomendações. Nada é aplicado sem licença."/>
        <Button Content="Ativar e continuar" Width="180" Height="42" Padding="0" Margin="0" HorizontalAlignment="Right" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Activate_Click"/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
