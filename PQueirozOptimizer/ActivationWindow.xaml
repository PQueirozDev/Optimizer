<Window x:Class="PQueirozOptimizer.ActivationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ativar PQueiroz Optimizer" Width="570" Height="510" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#101114" Foreground="#ECEEF2" FontFamily="Segoe UI">
  <Border Margin="1" Padding="42" Background="#15161A" BorderBrush="#2A2D34" BorderThickness="1"><StackPanel>
    <TextBlock Text="PQueiroz / Optimizer" FontSize="14" Foreground="#969BA6"/><TextBlock Text="Ative sua licença" FontSize="28" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="É necessária uma chave de acesso válida para usar o aplicativo." Foreground="#969BA6" TextWrapping="Wrap" Margin="0,0,0,24"/>
    <TextBlock Text="Chave de acesso" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="AccessKeyTextBox" Height="42" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12"/>
    <TextBlock Text="ID deste computador" FontSize="12" FontWeight="SemiBold" Margin="0,20,0,7"/><DockPanel><TextBox x:Name="MachineIdTextBox" IsReadOnly="True" Height="36" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="12" Background="#1B1D22" BorderBrush="#2A2D34"/><Button Content="Copiar" Width="78" Margin="10,0,0,0" Click="CopyMachineId_Click"/></DockPanel>
    <TextBlock x:Name="StatusText" Foreground="#EF4444" TextWrapping="Wrap" MinHeight="22" Margin="0,14,0,0"/><DockPanel Margin="0,18,0,0"><Button Content="Sair" Width="92" Click="Exit_Click"/><Button Content="Ativar e continuar" Width="156" HorizontalAlignment="Right" DockPanel.Dock="Right" Background="#648CFF" Foreground="#FFFFFF" Click="Activate_Click"/></DockPanel>
  </StackPanel></Border>
</Window>
