<Window x:Class="PQueirozOptimizer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Qrztweaks" Width="1320" Height="860" MinWidth="760" MinHeight="520"
 WindowStyle="None" Background="{DynamicResource BackgroundBrush}" FontFamily="{StaticResource UiFont}"
 TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
 Icon="pack://application:,,,/Qrztweaks;component/Assets/app.ico" Loaded="Window_Loaded" StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/></WindowChrome.WindowChrome>
 <Border x:Name="MainRootBorder" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
  <Grid x:Name="RootGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>


   <!-- ============ BARRA LATERAL ============ -->
   <Border x:Name="SidebarBorder" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
    <DockPanel>
     <!-- Logo (faz parte da área de arrastar a janela) -->
     <StackPanel x:Name="SidebarLogo" DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,16,14">
      <Border Width="36" Height="36">
       <Image Source="pack://application:,,,/Qrztweaks;component/Assets/app.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <StackPanel x:Name="SidebarLogoText" Margin="12,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="Qrztweaks" FontSize="14" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
       <TextBlock Text="PC OPTIMIZER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
      </StackPanel>
     </StackPanel>

     <!-- Rodapé: HUD ao vivo (CPU, GPU, RAM e ping), licença e versão -->
     <Border x:Name="HudPanel" DockPanel.Dock="Bottom" Margin="14,8,14,16" Padding="14,12" CornerRadius="12" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <StackPanel>
       <DockPanel Margin="0,0,0,10">
        <TextBlock x:Name="HudPing" DockPanel.Dock="Right" Text="-- ms" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Tag="dado-do-sistema" ToolTip="Latência até 1.1.1.1"/>
        <Ellipse x:Name="HudLiveDot" Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="NavFooterStatus" Text="Monitor ao vivo" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="18"/><RowDefinition Height="18"/></Grid.RowDefinitions>
        <TextBlock Text="CPU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        <ProgressBar x:Name="HudCpuBar" Grid.Column="1" Height="4" Maximum="100" VerticalAlignment="Center"/>
        <TextBlock x:Name="HudCpuText" Grid.Column="2" Text="--" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="dado-do-sistema"/>
        <TextBlock Grid.Row="1" Text="GPU" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        <ProgressBar x:Name="HudGpuBar" Grid.Row="1" Grid.Column="1" Height="4" Maximum="100" VerticalAlignment="Center"/>
        <TextBlock x:Name="HudGpuText" Grid.Row="1" Grid.Column="2" Text="--" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="dado-do-sistema"/>
        <TextBlock Grid.Row="2" Text="RAM" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        <ProgressBar x:Name="HudRamBar" Grid.Row="2" Grid.Column="1" Height="4" Maximum="100" VerticalAlignment="Center"/>
        <TextBlock x:Name="HudRamText" Grid.Row="2" Grid.Column="2" Text="--" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Tag="dado-do-sistema"/>
       </Grid>
       <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,10,0,8"/>
       <DockPanel>
        <TextBlock x:Name="VersionLabel" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0"/>
        <TextBlock x:Name="LicenseLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
       </DockPanel>
      </StackPanel>
     </Border>

     <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,0">
      <StackPanel x:Name="NavStack" KeyboardNavigation.DirectionalNavigation="Cycle">
       <TextBlock x:Name="NavSecMonitor" Text="MONITORAR" Style="{StaticResource SectionHeaderStyle}" Margin="12,6,0,6"/>
       <RadioButton x:Name="NavDashboard" Tag="dashboard" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavDashboardText" Text="Command Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavPerfLab" Tag="perflab" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" Style="{StaticResource NavIcon}"/><TextBlock Text="Performance Lab" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>

       <TextBlock x:Name="NavSecOptimizations" Text="OTIMIZAÇÕES" Style="{StaticResource SectionHeaderStyle}"/>
       <RadioButton x:Name="NavSmart" Tag="smart" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource NavIcon}"/><TextBlock Text="Smart Optimize" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavOpt" Tag="optimization" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <DockPanel>
         <Border x:Name="NavOptBadge" DockPanel.Dock="Right" Padding="7,1" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
          <TextBlock x:Name="NavOptBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
         </Border>
         <TextBlock Text="&#xE945;" Style="{StaticResource NavIcon}"/>
         <TextBlock x:Name="NavOptText" Text="Otimizações" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </DockPanel>
       </RadioButton>
       <RadioButton x:Name="NavServices" Tag="services" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE912;" Style="{StaticResource NavIcon}"/><TextBlock Text="Serviços" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavApps" Tag="apps" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}"/><TextBlock Text="Apps" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavStartup" Tag="startup" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource NavIcon}"/><TextBlock Text="Inicialização" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavDrivers" Tag="drivers" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavDriversText" Text="Drivers" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock x:Name="NavDriversBadgeText" Visibility="Collapsed"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavIsos" Tag="isos" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavIsosText" Text="Imagens do Windows" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavTools" Tag="tools" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavToolsText" Text="Ferramentas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavCustomize" Tag="customize" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE771;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavCustomizeText" Text="Personalizar Windows" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavHistory" Tag="history" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavHistoryText" Text="Atividade e reversão" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>

       <TextBlock x:Name="NavSecMaintenance" Text="MANUTENÇÃO" Style="{StaticResource SectionHeaderStyle}"/>
       <RadioButton x:Name="NavResources" Tag="resources" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Style="{StaticResource NavIcon}"/><TextBlock Text="Recursos" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavFixes" Tag="fixes" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Correções" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavDiagnostics" Tag="diagnostics" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Central de diagnóstico" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavRestore" Tag="restore" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource NavIcon}"/><TextBlock Text="Pontos de restauração" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>

       <TextBlock x:Name="NavSecGames" Text="JOGOS E REDE" Style="{StaticResource SectionHeaderStyle}"/>
       <RadioButton x:Name="NavGaming" Tag="gaming" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <DockPanel>
         <Border x:Name="NavGamingBadge" DockPanel.Dock="Right" Padding="7,1" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="ATIVO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
         </Border>
         <TextBlock Text="&#xE7FC;" Style="{StaticResource NavIcon}"/>
         <TextBlock Text="Modo Jogo" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </DockPanel>
       </RadioButton>
       <RadioButton x:Name="NavNetwork" Tag="network" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" Style="{StaticResource NavIcon}"/><TextBlock Text="Rede" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>

       <TextBlock x:Name="NavSecSystem" Text="SISTEMA" Style="{StaticResource SectionHeaderStyle}"/>
       <RadioButton x:Name="NavSettings" Tag="settings" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavSettingsText" Text="Configurações" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavBios" Tag="bios" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource NavIcon}"/><TextBlock Text="BIOS / UEFI" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavBiosAdvisor" Tag="biosadvisor" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="BIOS Advisor" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavPatchNotes" Tag="patchnotes" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}"/><TextBlock Text="Patch notes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavAbout" Tag="about" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavAboutText" Text="Sobre" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavAdmin" Tag="admin" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D7;" Style="{StaticResource NavIcon}"/><TextBlock Text="Chave de administrador" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>

   <!-- ============ ÁREA PRINCIPAL ============ -->
   <Grid Grid.Column="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MaxWidth="388"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <!-- Barra superior: busca rápida (Ctrl+K), estado e controles da janela -->
    <TextBlock x:Name="TitlePageHint" Visibility="Collapsed"/>
    <TextBlock x:Name="TitleRamChip" Visibility="Collapsed"/>
    <Grid x:Name="SearchHost" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="36,11,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
     <Border x:Name="SearchBorder" CornerRadius="12" Height="34" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <DockPanel Margin="12,0,6,0">
       <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource IconText}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0"/>
       <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
        <TextBlock Text="Ctrl K" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Tag="dado-do-sistema"/>
       </Border>
       <Grid>
        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0" FontSize="12.5" VerticalAlignment="Center" Style="{x:Null}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" GotKeyboardFocus="SearchBox_GotFocus" LostKeyboardFocus="SearchBox_LostFocus"/>
        <TextBlock x:Name="SearchPlaceholder" Text="Buscar recursos, ajustes e páginas…" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center"/>
       </Grid>
      </DockPanel>
     </Border>
     <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBorder}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Width="460">
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8" Margin="0,0,14,14">
       <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000"/></Border.Effect>
       <StackPanel x:Name="SearchResults"/>
      </Border>
     </Popup>
    </Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
     <Border CornerRadius="17" Padding="12,0" Height="34" Margin="0,11,8,0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
       <TextBlock x:Name="TitleOptChip" Text="Pronto" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <Border CornerRadius="17" Padding="12,0" Height="34" Margin="0,11,8,0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Ellipse x:Name="TitleAdminDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="0,0,7,0"/>
       <TextBlock x:Name="TitleAdminChip" Text="Verificando" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <Button x:Name="LangButton" Content="PT" Style="{StaticResource ChipButton}" Margin="0,11,6,0" Click="LangButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button x:Name="ThemeButton" Style="{StaticResource ChipButton}" Margin="0,11,14,0" FontFamily="{StaticResource IconFont}" FontSize="12.5" Click="ThemeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button Style="{StaticResource TitleBarBtnStyle}" Content="&#xE921;" ToolTip="Minimizar" Click="BtnMinimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarBtnStyle}" Content="&#xE922;" Click="BtnMaximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button Style="{StaticResource TitleBarCloseBtnStyle}" Content="&#xE8BB;" ToolTip="Fechar" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
    </StackPanel>

    <!-- Cabeçalho da página: ícone, seção, título e subtítulo -->
    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="36,8,36,22">
     <Border x:Name="PageBadge" DockPanel.Dock="Right" Visibility="Collapsed" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="14,7">
      <TextBlock x:Name="PageBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
     </Border>
     <Border x:Name="PageIconChip" DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="11" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
      <TextBlock x:Name="PageIcon" Text="&#xE80F;" Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="PageEyebrow" Text="MONITORAR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,3"/>
      <TextBlock x:Name="PageTitle" Text="Visão geral" FontSize="24" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <TextBlock x:Name="PageSubtitle" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
    </DockPanel>

    <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Grid.ColumnSpan="3" Margin="36,0,22,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid x:Name="ContentHost" Margin="0,0,14,8" MaxWidth="1640"/>
    </ScrollViewer>

    <!-- Barra de status -->
    <Border Grid.Row="3" Grid.ColumnSpan="3" Margin="36,12,36,18" Padding="14,10" CornerRadius="16" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
     <StackPanel>
      <DockPanel>
       <Button Content="Ver atividade" DockPanel.Dock="Right" Click="History_Click" Margin="12,0,0,0" Padding="12,5" Style="{StaticResource GhostButton}"/>
       <StackPanel x:Name="LastActivityPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="460" Visibility="Collapsed">
        <Ellipse x:Name="LastActivityDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="LastActivityText" MaxWidth="440" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Tag="dado-do-sistema"/>
       </StackPanel>
       <Border Width="20" Height="28" Margin="0,0,10,0">
        <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="14" Foreground="{DynamicResource MutedBrush}"/>
       </Border>
       <TextBlock x:Name="OperationStatus" Text="Pronto para começar" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
      </DockPanel>
      <ProgressBar x:Name="OperationProgress" Height="4" Margin="0,10,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
     </StackPanel>
    </Border>

    <!-- Notificações (toasts) -->
    <StackPanel x:Name="ToastHost" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,84" Width="360" IsHitTestVisible="True"/>
   </Grid>

   <!-- Tutorial: escurece a janela e ilumina um elemento por vez (MainWindow.Tutorial.cs) -->
   <Grid x:Name="TutorialLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="50"/>

   <!-- Guia de configuração do BIOS Advisor (Pages/MainWindow.BiosAdvisorGuide.cs) -->
   <Grid x:Name="AdvisorLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="55"/>

   <!-- Janela de atualização (MainWindow.UpdateDialog.cs) -->
   <Grid x:Name="UpdateLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="60"/>

  </Grid>
 </Border>
</Window>
