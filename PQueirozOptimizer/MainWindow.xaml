<Window x:Class="PQueirozOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PQueiroz Optimizer" Width="1380" Height="870"
        MinWidth="1060" MinHeight="700"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BackgroundBrush}"
        Icon="pack://application:,,,/Assets/app.ico"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Margin" Value="10,14,0,5"/>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border -->
    <Border x:Name="MainRootBorder"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom Modern Titlebar (Clean IDE style) -->
                <RowDefinition Height="42"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Titlebar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <!-- Left: App Brand & Icon -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="22" Height="22" CornerRadius="6"
                                Background="{DynamicResource PanelHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Margin="0,0,10,0" ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/app.png" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="PQueiroz Optimizer" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource PanelHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="5,1,5,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="PRO" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Center: Clean Status / Breadcrumb -->
                    <TextBlock x:Name="TitlePageHint" Text="✦ Otimizador e Gerenciador do Windows"
                               FontSize="11.5" FontWeight="Medium"
                               Foreground="{DynamicResource MutedBrush}"
                               Opacity="0.75"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <!-- Right: Telemetry chips, Theme toggle & Window Controls (Antigravity IDE inspired) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Chip: Optimization Status -->
                        <Border Background="{DynamicResource PanelHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="8,3,8,3" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock x:Name="TitleOptChip" Text="100% Otimizado" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Chip: Live RAM -->
                        <Border Background="{DynamicResource PanelHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="8,3,8,3" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💾" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TitleRamChip" Text="1293 MB" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Chip: Admin Status -->
                        <Border Background="{DynamicResource PanelHoverBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="8,3,8,3" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="TitleAdminDot" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TitleAdminChip" Text="Verificando..." FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Language Toggle Button -->
                        <Button x:Name="LangButton" Content="🌐 PT" Width="48" Height="30" Padding="0"
                                Margin="0,0,8,0" ToolTip="Alternar idioma / Switch language (PT / EN)"
                                Click="LangButton_Click"
                                FontWeight="SemiBold" FontSize="11"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- Theme Toggle Button -->
                        <Button x:Name="ThemeButton" Content="☀" Width="34" Height="30" Padding="0"
                                Margin="0,0,8,0" ToolTip="Alternar tema claro / escuro"
                                Click="ThemeButton_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>

                        <!-- Window Buttons (Minimize, Maximize, Close) -->
                        <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarBtnStyle}" Content="─"
                                ToolTip="Minimizar" Click="BtnMinimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarBtnStyle}" Content="▢"
                                ToolTip="Maximizar / Restaurar" Click="BtnMaximize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnClose" Style="{StaticResource TitleBarCloseBtnStyle}" Content="✕"
                                ToolTip="Fechar" Click="BtnClose_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Body: Sidebar + Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar (Clean SaaS & IDE Navigation) -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,14,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Navigation Items -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="NavSecMonitor" Style="{StaticResource SectionHeaderStyle}" Text="MONITORAR"/>
                                <Button x:Name="NavDashboard" Style="{StaticResource NavButtonStyle}" Content="⌂   Dashboard"
                                        Tag="dashboard" Click="Navigate_Click"/>

                                <TextBlock x:Name="NavSecOptimizations" Style="{StaticResource SectionHeaderStyle}" Text="OTIMIZAÇÕES"/>
                                <Button x:Name="NavOpt" Style="{StaticResource NavButtonStyle}" Tag="optimization" Click="Navigate_Click">
                                    <DockPanel LastChildFill="False" Width="188">
                                        <TextBlock x:Name="NavOptText" Text="⚡   Otimização" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Border x:Name="NavOptBadge" Background="{DynamicResource PanelHoverBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="6,1,6,1" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="NavOptBadgeText" Text="5" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="NavDrivers" Style="{StaticResource NavButtonStyle}" Tag="drivers" Click="Navigate_Click">
                                    <DockPanel LastChildFill="False" Width="188">
                                        <TextBlock x:Name="NavDriversText" Text="▣   Drivers" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Border Background="{DynamicResource PanelHoverBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="10" Padding="6,1,6,1" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="NavDriversBadgeText" Text="1" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                    </DockPanel>
                                </Button>
                                <Button x:Name="NavIsos" Style="{StaticResource NavButtonStyle}" Content="◈   ISOs do Windows"
                                        Tag="isos" Click="Navigate_Click"/>
                                <Button x:Name="NavTools" Style="{StaticResource NavButtonStyle}" Content="▦   Ferramentas"
                                        Tag="tools" Click="Navigate_Click"/>

                                <TextBlock x:Name="NavSecSystem" Style="{StaticResource SectionHeaderStyle}" Text="SISTEMA"/>
                                <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Content="⚙   Configurações"
                                        Tag="settings" Click="Navigate_Click"/>
                                <Button x:Name="NavAbout" Style="{StaticResource NavButtonStyle}" Content="?   Sobre"
                                        Tag="about" Click="Navigate_Click"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Minimalist Footer -->
                        <Border Grid.Row="1" Margin="0,10,0,0" Padding="8,10,8,2"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="NavFooterStatus" Grid.Column="1" Text="Sistema Ativo" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="v1.0.0" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Column="1" Margin="28,20,28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Content Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Dashboard"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"/>

                            <Border x:Name="PageBadge" Visibility="Collapsed"
                                    Background="{DynamicResource PanelHoverBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,3,8,3" Margin="14,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="PageBadgeText" Text="Modo Gamer"
                                           FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Main Panel Container -->
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                            CornerRadius="12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Grid x:Name="ContentHost"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
