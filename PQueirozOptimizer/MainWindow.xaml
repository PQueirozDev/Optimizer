<Window x:Class="PQueirozOptimizer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PQueiroz Optimizer" Width="1320" Height="860" MinWidth="1060" MinHeight="700"
 WindowStyle="None" Background="{DynamicResource BackgroundBrush}" FontFamily="{StaticResource UiFont}"
 TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
 Icon="pack://application:,,,/PQueirozOptimizer;component/Assets/app.ico" Loaded="Window_Loaded" StateChanged="Window_StateChanged">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/></WindowChrome.WindowChrome>
 <Border x:Name="MainRootBorder" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
  <Grid x:Name="RootGrid">
   <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- ============ BARRA LATERAL ============ -->
   <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
    <DockPanel>
     <!-- Logo (faz parte da área de arrastar a janela) -->
     <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,18,16,14">
      <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentGradientBrush}">
       <Image Source="pack://application:,,,/PQueirozOptimizer;component/Assets/app.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>
      <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
       <TextBlock Text="PQueiroz" FontSize="15" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}"/>
       <TextBlock Text="OPTIMIZER" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
      </StackPanel>
     </StackPanel>

     <!-- Rodapé: status, licença e versão -->
     <Border DockPanel.Dock="Bottom" Margin="14,8,14,16" Padding="14,12" CornerRadius="12" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <StackPanel>
       <StackPanel Orientation="Horizontal">
        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="NavFooterStatus" Text="Sistema ativo" FontSize="12" FontWeight="SemiBold"/>
       </StackPanel>
       <TextBlock x:Name="LicenseLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="15,4,0,0" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="15,2,0,0"/>
      </StackPanel>
     </Border>

     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,0">
      <StackPanel>
       <TextBlock x:Name="NavSecMonitor" Text="MONITORAR" Style="{StaticResource SectionHeaderStyle}" Margin="12,6,0,6"/>
       <RadioButton x:Name="NavDashboard" Tag="dashboard" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavDashboardText" Text="Visão geral" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>

       <TextBlock x:Name="NavSecOptimizations" Text="OTIMIZAÇÕES" Style="{StaticResource SectionHeaderStyle}"/>
       <RadioButton x:Name="NavOpt" Tag="optimization" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <DockPanel>
         <Border x:Name="NavOptBadge" DockPanel.Dock="Right" Padding="7,1" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
          <TextBlock x:Name="NavOptBadgeText" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
         </Border>
         <TextBlock Text="&#xE945;" Style="{StaticResource NavIcon}"/>
         <TextBlock x:Name="NavOptText" Text="Otimizações" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </DockPanel>
       </RadioButton>
       <RadioButton x:Name="NavStartup" Tag="startup" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource NavIcon}"/><TextBlock Text="Inicialização" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavDrivers" Tag="drivers" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavDriversText" Text="Drivers" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/><TextBlock x:Name="NavDriversBadgeText" Visibility="Collapsed"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavIsos" Tag="isos" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE958;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavIsosText" Text="Imagens do Windows" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavTools" Tag="tools" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavToolsText" Text="Ferramentas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavHistory" Tag="history" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavHistoryText" Text="Atividade e reversão" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>

       <TextBlock x:Name="NavSecSystem" Text="SISTEMA" Style="{StaticResource SectionHeaderStyle}"/>
       <RadioButton x:Name="NavSettings" Tag="settings" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavSettingsText" Text="Configurações" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavBios" Tag="bios" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Style="{StaticResource NavIcon}"/><TextBlock Text="BIOS / UEFI" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavPatchNotes" Tag="patchnotes" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}"/><TextBlock Text="Patch notes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavAbout" Tag="about" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}"/><TextBlock x:Name="NavAboutText" Text="Sobre" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
       <RadioButton x:Name="NavAdmin" Tag="admin" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D7;" Style="{StaticResource NavIcon}"/><TextBlock Text="Chave de administrador" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel>
       </RadioButton>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </Border>

   <!-- ============ ÁREA PRINCIPAL ============ -->
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="4" Background="{DynamicResource GlowBrush}" IsHitTestVisible="False"/>

    <!-- Barra superior -->
    <TextBlock x:Name="TitlePageHint" Visibility="Collapsed"/>
    <TextBlock x:Name="TitleRamChip" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
     <Border CornerRadius="15" Padding="12,0" Height="30" Margin="0,9,8,0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
       <TextBlock x:Name="TitleOptChip" Text="Pronto" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <Border CornerRadius="15" Padding="12,0" Height="30" Margin="0,9,8,0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Ellipse x:Name="TitleAdminDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="0,0,7,0"/>
       <TextBlock x:Name="TitleAdminChip" Text="Verificando" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <Button x:Name="LangButton" Content="PT" Style="{StaticResource ChipButton}" Margin="0,9,6,0" Click="LangButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button x:Name="ThemeButton" Style="{StaticResource ChipButton}" Margin="0,9,14,0" FontFamily="{StaticResource IconFont}" FontSize="13" Click="ThemeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button Style="{StaticResource TitleBarBtnStyle}" Content="&#xE921;" ToolTip="Minimizar" Click="BtnMinimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarBtnStyle}" Content="&#xE922;" Click="BtnMaximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     <Button Style="{StaticResource TitleBarCloseBtnStyle}" Content="&#xE8BB;" ToolTip="Fechar" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
    </StackPanel>

    <!-- Cabeçalho da página -->
    <StackPanel Grid.Row="1" Margin="36,6,36,22">
     <TextBlock Text="SEU COMPUTADOR, SOB CONTROLE" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
     <DockPanel>
      <Border x:Name="PageBadge" DockPanel.Dock="Right" Visibility="Collapsed" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="12,6">
       <TextBlock x:Name="PageBadgeText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
      </Border>
      <TextBlock x:Name="PageTitle" Text="Visão geral" FontSize="30" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
     </DockPanel>
    </StackPanel>

    <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Margin="36,0,22,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Grid x:Name="ContentHost" Margin="0,0,14,8"/>
    </ScrollViewer>

    <!-- Barra de status -->
    <Border Grid.Row="3" Margin="36,12,36,20" Padding="16,12" CornerRadius="14" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
     <StackPanel>
      <DockPanel>
       <Button Content="Ver atividade" DockPanel.Dock="Right" Click="History_Click" Margin="12,0,0,0" Padding="12,5" Style="{StaticResource GhostButton}"/>
       <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
        <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
       </Border>
       <TextBlock x:Name="OperationStatus" Text="Pronto para começar" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"/>
      </DockPanel>
      <ProgressBar x:Name="OperationProgress" Height="4" Margin="0,12,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
     </StackPanel>
    </Border>
   </Grid>

   <!-- Abertura: logo aparece e some revelando a interface (animada em PlayIntroAnimation) -->
   <Grid x:Name="IntroOverlay" Grid.ColumnSpan="2" Background="{DynamicResource BackgroundBrush}" IsHitTestVisible="False">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
     <Border x:Name="IntroLogo" Width="96" Height="96" CornerRadius="28" Background="{DynamicResource AccentGradientBrush}" RenderTransformOrigin="0.5,0.5" Opacity="0">
      <Border.RenderTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6"/></Border.RenderTransform>
      <Image Source="pack://application:,,,/PQueirozOptimizer;component/Assets/app.png" Width="58" Height="58" RenderOptions.BitmapScalingMode="HighQuality"/>
     </Border>
     <StackPanel x:Name="IntroTitle" Margin="0,22,0,0" HorizontalAlignment="Center" Opacity="0">
      <StackPanel.RenderTransform><TranslateTransform Y="10"/></StackPanel.RenderTransform>
      <TextBlock Text="PQueiroz" FontSize="26" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"/>
      <TextBlock Text="OPTIMIZER" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
     </StackPanel>
    </StackPanel>
   </Grid>
  </Grid>
 </Border>
</Window>
