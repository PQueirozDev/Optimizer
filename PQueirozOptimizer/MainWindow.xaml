<Window x:Class="PQueirozOptimizer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PQueiroz Optimizer" Width="1320" Height="860" MinWidth="1060" MinHeight="700"
 WindowStyle="None" Background="{DynamicResource BackgroundBrush}" FontFamily="Segoe UI"
 Icon="pack://application:,,,/PQueirozOptimizer;component/Assets/app.ico" Loaded="Window_Loaded" StateChanged="Window_StateChanged">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,12"/>
   <Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="14,24,0,8"/></Style>
 </Window.Resources>
 <Border x:Name="MainRootBorder" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
    <Grid>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
      <TextBlock Text="PQueiroz" FontWeight="SemiBold" FontSize="14"/><TextBlock Text=" / Optimizer" FontSize="14" Foreground="{DynamicResource MutedBrush}"/>
     </StackPanel>
     <TextBlock x:Name="TitlePageHint" Visibility="Collapsed"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <TextBlock x:Name="TitleOptChip" Text="Pronto" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
      <TextBlock x:Name="TitleRamChip" Visibility="Collapsed"/>
      <Ellipse x:Name="TitleAdminDot" Width="5" Height="5" Fill="{DynamicResource MutedBrush}" Margin="0,0,7,0"/>
      <TextBlock x:Name="TitleAdminChip" Text="Verificando" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,20,0"/>
      <Button x:Name="LangButton" Content="PT" Width="38" Height="28" Padding="0" Margin="0,0,6,0" Click="LangButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button x:Name="ThemeButton" Content="☀" Width="32" Height="28" Padding="0" Margin="0,0,12,0" Click="ThemeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button Style="{StaticResource TitleBarBtnStyle}" Content="─" Click="BtnMinimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarBtnStyle}" Content="□" Click="BtnMaximize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
      <Button Style="{StaticResource TitleBarCloseBtnStyle}" Content="×" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
     <DockPanel Margin="12,8,12,16">
      <StackPanel DockPanel.Dock="Bottom" Margin="14,16,0,0">
       <TextBlock x:Name="NavFooterStatus" Text="Pronto" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
       <TextBlock x:Name="VersionLabel" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
      </StackPanel>
      <StackPanel>
       <TextBlock x:Name="NavSecMonitor" Text="VISÃO GERAL" Style="{StaticResource SectionHeaderStyle}"/>
       <Button x:Name="NavDashboard" Content="Visão geral" Tag="dashboard" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
       <TextBlock x:Name="NavSecOptimizations" Text="GERENCIAR" Style="{StaticResource SectionHeaderStyle}"/>
       <Button x:Name="NavOpt" Tag="optimization" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click">
        <DockPanel Width="164"><Border x:Name="NavOptBadge" DockPanel.Dock="Right" Padding="5,0"><TextBlock x:Name="NavOptBadgeText" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border><TextBlock x:Name="NavOptText" Text="Otimizações"/></DockPanel>
       </Button>
       <Button x:Name="NavDrivers" Tag="drivers" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock x:Name="NavDriversText" Text="Drivers"/><TextBlock x:Name="NavDriversBadgeText" Visibility="Collapsed"/></StackPanel></Button>
       <Button x:Name="NavIsos" Content="Imagens do Windows" Tag="isos" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
       <Button x:Name="NavTools" Content="Ferramentas" Tag="tools" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
       <Button x:Name="NavHistory" Content="Atividade e reversão" Tag="history" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
       <TextBlock x:Name="NavSecSystem" Text="APLICATIVO" Style="{StaticResource SectionHeaderStyle}"/>
       <Button x:Name="NavSettings" Content="Configurações" Tag="settings" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
       <Button x:Name="NavAbout" Content="Sobre" Tag="about" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
       <Button x:Name="NavPatchNotes" Content="Patch notes" Tag="patchnotes" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
       <Button x:Name="NavBios" Content="BIOS / UEFI" Tag="bios" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
       <Button x:Name="NavAdmin" Content="Ativar chave de administrador" Tag="admin" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,24">
      <TextBlock Text="SEU COMPUTADOR, SOB CONTROLE" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8"/>
      <DockPanel><Border x:Name="PageBadge" DockPanel.Dock="Right" Visibility="Collapsed" VerticalAlignment="Center" Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="10,5"><TextBlock x:Name="PageBadgeText" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border><TextBlock x:Name="PageTitle" Text="Visão geral" FontSize="28" FontWeight="SemiBold"/></DockPanel>
     </StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="ContentHost" Margin="0,0,8,0"/></ScrollViewer>
     <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
      <StackPanel>
       <DockPanel><Button Content="Ver atividade" DockPanel.Dock="Right" Click="History_Click" Margin="12,0,0,0" Padding="8,3"/><TextBlock x:Name="OperationStatus" Text="Pronto para começar" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
       <ProgressBar x:Name="OperationProgress" Height="3" Margin="0,10,0,0" Visibility="Collapsed" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"/>
      </StackPanel>
     </Border>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>

