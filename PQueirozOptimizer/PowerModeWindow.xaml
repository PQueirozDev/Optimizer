<Window x:Class="PQueirozOptimizer.PowerModeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modo de energia" Width="440" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Icon="pack://application:,,,/Qrztweaks;component/Assets/app.ico">
  <Grid>
    <Border Background="{DynamicResource GlowBrush}" IsHitTestVisible="False"/>
    <StackPanel Margin="26,22,26,18">
      <DockPanel>
        <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentGradientBrush}">
          <TextBlock x:Name="HeaderIcon" Text="&#xE83F;" Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource OnAccentBrush}"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Modo de energia" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
          <TextBlock x:Name="SourceText" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>

      <TextBlock x:Name="ModesHeader" Text="MODO DE ENERGIA DO WINDOWS" Style="{StaticResource SectionHeaderStyle}" Margin="2,20,0,8"/>
      <StackPanel x:Name="ModesPanel"/>
      <TextBlock x:Name="PlansHeader" Text="PLANOS DE ENERGIA" Style="{StaticResource SectionHeaderStyle}" Margin="2,12,0,8"/>
      <StackPanel x:Name="PlansPanel"/>

      <DockPanel Margin="0,8,0,0">
        <Button Content="Fechar" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0" Padding="14,6" Click="Close_Click"/>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                   Text="O modo de energia vale para o plano Equilibrado; os planos substituem o modo."/>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
