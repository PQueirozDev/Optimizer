<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PQueirozOptimizer</AssemblyName>
    <RootNamespace>PQueirozOptimizer</RootNamespace>
    <Authors>Pedro Queiroz</Authors>
    <Company>Pedro Queiroz</Company>
    <Product>Qrztweaks</Product>
    <AssemblyTitle>Qrztweaks</AssemblyTitle>
    <Description>Aplicativo desktop para otimizacao, manutencao e gerenciamento do Windows.</Description>
    <Copyright>Copyright (c) Pedro Queiroz</Copyright>
    <PackageProjectUrl>https://pqueiroz.vercel.app/</PackageProjectUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\Qrz.powerplan.txt" />
    <Content Include="Assets\Qrz.powerplan.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Otimizador_de_PC.ps1" Link="Otimizador_de_PC.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
</Project>
