<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PQueirozOptimizer</AssemblyName>
    <RootNamespace>PQueirozOptimizer</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Authors>Pedro Queiroz</Authors>
    <Company>Pedro Queiroz</Company>
    <Product>PQueiroz Optimizer</Product>
    <AssemblyTitle>PQueiroz Optimizer</AssemblyTitle>
    <Description>Aplicativo desktop para otimizacao, manutencao e gerenciamento do Windows.</Description>
    <Copyright>Copyright (c) Pedro Queiroz</Copyright>
    <PackageProjectUrl>https://pqueiroz.vercel.app/</PackageProjectUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Content Include="..\Otimizador_de_PC.ps1" Link="Otimizador_de_PC.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
