<Window x:Class="PQueirozOptimizer.DiskLensWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DiskLens · Qrztweaks" Width="1120" Height="820" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterOwner"
 Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}"
 Icon="pack://application:,,,/Qrztweaks;component/Assets/app.ico" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel>
    <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Background="Transparent" Margin="0,0,0,4"/>
    <Border Background="{DynamicResource BackgroundBrush}"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border>
   </DockPanel></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabBorder" CornerRadius="8" Padding="14,10" Margin="0,0,6,0" Background="{DynamicResource PanelBrush}">
     <ContentPresenter ContentSource="Header"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="{DynamicResource CardBgBrush}"/>
   <Setter Property="AlternatingRowBackground" Value="{DynamicResource BackgroundBrush}"/><Setter Property="GridLinesVisibility" Value="None"/>
   <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/>
   <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="RowHeight" Value="34"/>
   <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="SelectionMode" Value="Single"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
   <Setter Property="Padding" Value="10,10"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,4"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <Button x:Name="CancelButton" Content="Cancelar" DockPanel.Dock="Right" Click="Cancel_Click" IsEnabled="False" Style="{StaticResource GhostButton}"/>
   <StackPanel><TextBlock Text="DiskLens" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
    <TextBlock Text="Entenda seu armazenamento. Revise antes de limpar." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,22,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="PathBox" VerticalContentAlignment="Center" ToolTip="Pasta ou unidade para analisar"/>
   <Button x:Name="BrowseButton" Grid.Column="1" Content="Escolher pasta" Click="Browse_Click" Margin="10,0,0,0"/>
   <Button x:Name="ScanButton" Grid.Column="2" Content="Analisar" Click="Scan_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
   <Button x:Name="DuplicateButton" Grid.Column="3" Content="Buscar duplicados" Click="Duplicates_Click" IsEnabled="False" Margin="10,0,0,0"/>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
   <StackPanel><TextBlock x:Name="SummaryText" Text="Escolha uma pasta ou uma unidade para começar." FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="DetailText" Text="A análise lê tamanhos; a busca de duplicados compara o conteúdo com SHA-256." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <TabControl x:Name="Tabs" Grid.Row="3">
   <TabItem Header="Mapa de espaço">
    <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><Button x:Name="UpButton" Content="Subir" DockPanel.Dock="Right" Click="Up_Click" IsEnabled="False"/>
      <TextBlock x:Name="MapPath" Text="Clique em uma pasta no mapa para explorar." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     </DockPanel>
     <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12" ClipToBounds="True"><Canvas x:Name="MapCanvas" SizeChanged="Map_SizeChanged"/></Border>
    </Grid>
   </TabItem>
   <TabItem Header="Pastas gigantes">
    <DataGrid x:Name="FoldersGrid" Margin="0,12,0,0" IsReadOnly="True" MouseDoubleClick="Folder_DoubleClick">
     <DataGrid.Columns><DataGridTextColumn Header="Pasta (duplo clique para explorar)" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Tamanho lógico" Binding="{Binding SizeText}" Width="145"/></DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem Header="Arquivos grandes">
    <DataGrid x:Name="FilesGrid" Margin="0,12,0,0" MouseDoubleClick="File_DoubleClick">
     <DataGrid.Columns><DataGridCheckBoxColumn Header="Limpar" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
      <DataGridTextColumn Header="Arquivo" Binding="{Binding File.Path}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Tamanho" Binding="{Binding File.SizeText}" Width="130" IsReadOnly="True"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
   <TabItem x:Name="DuplicatesTab" Header="Duplicados">
    <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="DuplicatesText" Text="Inicie a busca após analisar. Nenhum arquivo é marcado automaticamente." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <DataGrid x:Name="DuplicatesGrid" Grid.Row="1" MouseDoubleClick="File_DoubleClick">
      <DataGrid.Columns><DataGridCheckBoxColumn Header="Limpar" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
       <DataGridTextColumn Header="Grupo" Binding="{Binding Group}" Width="65" IsReadOnly="True"/><DataGridTextColumn Header="Arquivo" Binding="{Binding File.Path}" Width="*" IsReadOnly="True"/>
       <DataGridTextColumn Header="Tamanho" Binding="{Binding File.SizeText}" Width="115" IsReadOnly="True"/>
       <DataGridTextColumn Header="Cópia preservada" Binding="{Binding KeepPath}" Width="210" IsReadOnly="True"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
  </TabControl>
  <StackPanel Grid.Row="4" Margin="0,16,0,0">
   <ProgressBar x:Name="ProgressBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/>
   <DockPanel><Button x:Name="CleanButton" Content="Revisar e enviar à Lixeira" DockPanel.Dock="Right" Click="Clean_Click" IsEnabled="False"/>
    <TextBlock x:Name="StatusText" Text="Nenhum arquivo é removido durante a análise." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
   </DockPanel>
  </StackPanel>
 </Grid>
</Window>
