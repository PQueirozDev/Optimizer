<Application x:Class="PQueirozOptimizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PQueirozOptimizer"
             Startup="Application_Startup">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Design system: tokens (fontes e escala), estilos de texto e controles -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml"/>
        <ResourceDictionary Source="Themes/Typography.xaml"/>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Paleta inicial (Azul meia-noite). ThemeService.Apply substitui estes valores em tempo de execução;
           eles ficam aqui para o designer e para os testes que montam a interface sem abrir o app. -->
      <SolidColorBrush x:Key="BackgroundBrush" Color="#07080B"/>
      <SolidColorBrush x:Key="HeaderBrush" Color="#07080B"/>
      <SolidColorBrush x:Key="SidebarBrush" Color="#0A0B0F"/>
      <SolidColorBrush x:Key="PanelBrush" Color="#111318"/>
      <SolidColorBrush x:Key="PanelHoverBrush" Color="#181B22"/>
      <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#111318"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#0F1116"/>
      <SolidColorBrush x:Key="CardBgBrush" Color="#0F1116"/>
      <SolidColorBrush x:Key="CardInsetBrush" Color="#0A0B0F"/>
      <SolidColorBrush x:Key="CardElevatedBrush" Color="#16181D"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#23262E"/>
      <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1A1C22"/>
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A3D45"/>
      <SolidColorBrush x:Key="TextBrush" Color="#F4F6FA"/>
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C1C7D2"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#8A92A1"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#2B3B82F6"/>
      <SolidColorBrush x:Key="AccentTextBrush" Color="#629BF8"/>
      <SolidColorBrush x:Key="OnAccentBrush" Color="#000000"/>
      <SolidColorBrush x:Key="PrimaryFillBrush" Color="#EAF1FE"/>
      <SolidColorBrush x:Key="OnPrimaryBrush" Color="#0A0F1C"/>
      <SolidColorBrush x:Key="SecondaryFillBrush" Color="#243B82F6"/>
      <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#4D3B82F6"/>
      <SolidColorBrush x:Key="OnSecondaryBrush" Color="#AACBFB"/>
      <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2434D399"/>
      <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#24FBBF24"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#24F87171"/>
      <SolidColorBrush x:Key="InfoBrush" Color="#5CC8FF"/>
      <SolidColorBrush x:Key="InfoSoftBrush" Color="#245CC8FF"/>
      <SolidColorBrush x:Key="NavSelectedBrush" Color="#0EFFFFFF"/>
      <SolidColorBrush x:Key="NavSelectedBorderBrush" Color="#10FFFFFF"/>
      <SolidColorBrush x:Key="NavHoverBrush" Color="#08FFFFFF"/>
      <SolidColorBrush x:Key="ChartLineBrush" Color="#3B82F6"/>
      <SolidColorBrush x:Key="ChartSecondaryBrush" Color="#5CC8FF"/>
      <SolidColorBrush x:Key="ChartGridBrush" Color="#0CF4F6FA"/>
      <LinearGradientBrush x:Key="ChartFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#553B82F6" Offset="0"/>
        <GradientStop Color="#003B82F6" Offset="1"/>
      </LinearGradientBrush>
      <Color x:Key="ShadowColor">#000000</Color>
      <Color x:Key="AccentColor">#3B82F6</Color>
      <Color x:Key="InfoColor">#5CC8FF</Color>
      <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#3B82F6" Offset="1"/>
      </LinearGradientBrush>
      <RadialGradientBrush x:Key="GlowBrush" Center="0.78,0" GradientOrigin="0.78,0" RadiusX="0.7" RadiusY="0.85">
        <GradientStop Color="#163B82F6" Offset="0"/>
        <GradientStop Color="#003B82F6" Offset="1"/>
      </RadialGradientBrush>
      <SolidColorBrush x:Key="HeroBrush" Color="#121722"/>
      <SolidColorBrush x:Key="CardBorderBrush" Color="#1A1C22"/>
      <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#23262E"/>
      <SolidColorBrush x:Key="BorderHoverBrush" Color="#803B82F6"/>
      <Color x:Key="GlowColor">#3B82F6</Color>
    </ResourceDictionary>
  </Application.Resources>
</Application>
